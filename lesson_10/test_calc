@allure.severity("critical")
@pytest.mark.parametrize('result_test', [(str(result))])
def test_calculator(result_test):
    with allure.step("РћС‚РєСЂС‹РІР°РµРј СЃС‚СЂР°РЅРёС†Сѓ Р±СЂР°СѓР·РµСЂР°"):
        browser = webdriver.Chrome()
        calc_page = CalcPage(browser, URL)

    with allure.step("Р Р°Р±РѕС‚Р°РµРј СЃ С„РѕСЂРјРѕР№  РєР°Р»СЊРєСѓР»СЏС‚РѕСЂРѕРј: "):
        calc_page.input_field(selector[0], time_delay)
        calc_page.click_button(collection_symbol)

    with allure.step("РџСЂРѕРІРµСЂРєР° РёС‚РѕРіРѕРІ СЂР°СЃС‡РµС‚Р°."):
        text = calc_page.waiting_result(selector[0], str(result), selector[1])
        assert text == result_test

    with allure.step("Р—Р°РєСЂС‹С‚РёРµ СЃРµСЃСЃРёРё Р±СЂР°СѓР·РµСЂР°."):
        browser.quit()