URL = "https://bonigarcia.dev/selenium-webdriver-java/slow-calculator.html"
time_delay = 45
collection_symbol = ['7', '+', '8', '=']
result = 15
selector = ['#delay', 'div.screen']


@allure.epic("РљР°Р»СЊРєСѓР»СЏС‚РѕСЂ")
@allure.title("РљР°Р»СЊРєСѓР»СЏС‚РѕСЂ")
